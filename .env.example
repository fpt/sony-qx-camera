# Copy to .env and fill in from the label inside each camera's battery cover.
# One block per camera; the prefix (QX10, QX100, ...) is the profile name used by `qx -c`.
QX10_SSID="DIRECT-XXXX:DSC-QX10"
QX10_PASSWORD="XXXXXXXX"

QX100_SSID="DIRECT-XXXX:DSC-QX100"   # optional: found by scanning if omitted
QX100_PASSWORD="XXXXXXXX"

# Alpha/RX bodies answer at a different address; find it with SSDP or try this one.
A6300_SSID="DIRECT-XXXX:ILCE-6300"
A6300_PASSWORD="XXXXXXXX"
A6300_ENDPOINT=http://192.168.122.1:8080/sony/camera

# Optional shared settings:
# QX_CAMERA=qx10                               # default profile for `connect`
# QX_IFACE=wlx...                              # Wi-Fi interface to use (nmcli dev)
# QX_ENDPOINT=http://10.0.0.1:10000/sony/camera
# QX_OUTDIR=photos                             # where downloads go
